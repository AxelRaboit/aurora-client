APP_SECRET=your-random-secret-here
DATABASE_URL="postgresql://app:password@127.0.0.1:5432/aurora-client?serverVersion=18&charset=utf8"

# Generate each key with: php -r "echo base64_encode(random_bytes(32)) . PHP_EOL;"
AURORA_MOUNT_POINT_KEY=replace_with_base64_32_bytes_key
AURORA_ENCRYPTION_KEY=replace_with_base64_32_bytes_key

# Override .env defaults here only if your Ollama runs on a different host
# or you want a different model — leaving these commented out keeps the
# values from .env (qwen3:8b chat + qwen2.5vl:3b vision on localhost:11434).
# ASSISTANT_OLLAMA_URL=http://localhost:11434
# ASSISTANT_CHAT_MODEL=qwen3:8b
# ASSISTANT_VISION_MODEL=qwen2.5vl:3b
