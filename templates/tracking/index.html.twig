{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ 'backend.tracking.title'|trans }} - {{ parent() }}{% endblock %}

{% block body %}
    <div class="space-y-4">
        <div>
            <h1 class="text-xl font-semibold text-primary">{{ 'backend.tracking.title'|trans }}</h1>
            <p class="text-sm text-muted mt-1">{{ 'backend.tracking.subtitle'|trans }}</p>
        </div>

        <div class="bg-surface border border-line rounded-lg p-6">
            <p class="text-sm text-secondary">{{ 'backend.tracking.placeholder'|trans }}</p>
        </div>
    </div>
{% endblock %}
