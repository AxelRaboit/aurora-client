{# One template for both rooms and pages. A room is recognised by its post type
   and gets the price panel; anything else renders as a plain article. Splitting
   them would mean overriding ThemeResolver, which resolves by template name and
   not by post type. #}
{% extends 'Frontend/themes/bnb/layout.html.twig' %}

{# `image` used to fall back to `featuredMediaData`. That variable is gone —
   aurora-core renamed the featured image to the thumbnail and stopped passing
   it — and the fallback was already dead weight, because `ogImage` falls back
   to the thumbnail on the server side. #}
{% block seo_define %}{% do seo({
    title: translationData.metaTitle ?? translationData.title,
    description: translationData.metaDescription,
    image: translationData.ogImage,
    type: 'article',
    noindex: translationData.noindex|default(false),
}) %}{% endblock %}

{% block body %}
{% set isRoom = postData.postType.slug == 'chambre' %}
{% set fields = translationData.customFields|default({}) %}

{# `featuredMediaData` is gone: aurora-core renamed the featured image to the
   thumbnail and stopped passing it as a variable of its own. What is left is
   `translationData.ogImage`, which falls back to the thumbnail when no social
   image is set — the same picture this hero used to show. It carries no focal
   point (that one belongs to the card, where a wide photo has to work in a
   narrow frame), so the crop is centred. #}
{% if translationData.ogImage %}
    <div class="w-full h-[42vh] min-h-72 bg-[#efe8dd] overflow-hidden">
        <img src="{{ translationData.ogImage.publicUrl }}" alt="{{ translationData.title }}"
             class="w-full h-full object-cover">
    </div>
{% endif %}

{# Reading width comes from the theme's own config, set in the backend, so an
   editor can widen the column without touching this file. #}
<article class="{{ themeContext.contentWidthClass() }} px-5 py-14">
    <h1 class="font-serif text-4xl">{{ translationData.title }}</h1>

    {% if translationData.description %}
        <p class="text-lg text-[#7a7266] mt-4 leading-relaxed">{{ translationData.description }}</p>
    {% endif %}

    {% if isRoom %}
        <div class="mt-6 rounded-xl border border-[#e5ddd1] bg-white p-5 flex flex-wrap items-center gap-x-8 gap-y-3">
            {% if fields.prix_nuit is defined %}
                <p><span class="font-serif text-2xl">{{ fields.prix_nuit }} €</span><span class="text-[#7a7266] text-sm"> / nuit</span></p>
            {% endif %}
            {# `type_lit` was declared on the post type, filled on every room,
               and shown nowhere — a field an editor maintains for no reader.
               It is the second thing anyone asks about a room. #}
            <p class="text-sm text-[#7a7266]">
                {{ fields.capacite|default('?') }} personnes
                {%- if fields.superficie is defined %} · {{ fields.superficie }} m²{% endif %}
                {%- if fields.type_lit is defined %} · {{ fields.type_lit }}{% endif %}
            </p>
            {% if fields.disponible|default(false) %}
                <a href="#" class="ml-auto rounded-full bg-[#2c2a26] text-[#fbf9f6] text-sm px-5 py-2 hover:bg-[#9a6f4a] transition-colors">
                    Demander ces dates
                </a>
            {% else %}
                <span class="ml-auto text-sm text-[#9a6f4a]">Indisponible pour le moment</span>
            {% endif %}
        </div>

        {% if terms.equipement is defined %}
            <div class="flex flex-wrap gap-2 mt-5">
                {% for amenity in terms.equipement %}
                    <span class="rounded-full border border-[#e5ddd1] px-3 py-1 text-xs text-[#7a7266]">{{ amenity }}</span>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}

    {# The standfirst used to be printed here from the meta description. It is
       an Introduction block now, so it arrives inside the body — written for
       the reader rather than for a search snippet.

       The body is a content grid since aurora-core migrated every plain block
       column into one. Rendering `content` alone would have kept working for
       exactly as long as nobody edited the page: `blocks` is deliberately not
       dropped, so it still holds what it held, and it stops being written the
       moment an author touches the grid. The site would have gone on showing
       the old words with no error anywhere.

       The core partial is included rather than reimplemented, so a zone type
       added there arrives here without this file being touched — and so this
       theme cannot drift into rendering a shape the editor no longer writes.
       `content` stays as the fallback for a publication that has no grid. #}
    <div class="prose prose-neutral max-w-none mt-8">
        {% if grid %}
            {{ include('Frontend/themes/default/editorial/post/_grid.html.twig', {grid: grid, locale: locale}) }}
        {% else %}
            {{ content|raw }}
        {% endif %}
    </div>
</article>
{% endblock %}
