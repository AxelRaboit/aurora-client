###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-env-local
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/aurora_client?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://localhost:1025
MAILER_FROM=noreply@aurora-client.local
ADMIN_EMAIL=admin@aurora-client.local
###< symfony/mailer ###

APP_NAME=aurora-client

###> aurora/mount-point ###
AURORA_MOUNT_POINT_KEY=replace_with_base64_32_bytes_key
###< aurora/mount-point ###

###> aurora/encryption ###
# Used by Aurora's generic encryption service (EncryptionService + Doctrine
# encrypted_text / encrypted_string types). Must be a base64-encoded 32-byte
# key. Generate one with: php -r "echo base64_encode(random_bytes(32));"
AURORA_ENCRYPTION_KEY=replace_with_base64_32_bytes_key
###< aurora/encryption ###

###> aurora/ocr ###
# Required by aurora-core's Billing OCR module. Keep the defaults if you
# don't use OCR — services boot lazily and only error when invoked.
OCR_DOCTR_URL=http://localhost:8001
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OCR_HTTP_TIMEOUT=600
OCR_RENDER_DPI=200
OCR_NUM_CTX=12288
OCR_NUM_PREDICT=-1
###< aurora/ocr ###

###> aurora/assistant ###
# Required by aurora-core's Assistant module. The chat model MUST support
# tool calling (qwen3:*, qwen2.5:*, llama3.1:*, mistral-nemo). All values
# can be overridden at runtime via /backend/settings → Assistant tab.
ASSISTANT_PROVIDER=ollama
ASSISTANT_OLLAMA_URL=${OLLAMA_URL}
ASSISTANT_CHAT_MODEL=qwen3:8b
ASSISTANT_VISION_MODEL=${OLLAMA_VISION_MODEL}
ASSISTANT_HTTP_TIMEOUT=300
ASSISTANT_NUM_CTX=8192
ANTHROPIC_API_KEY=
###< aurora/assistant ###

# ====================== CLIENT CUSTOM ======================
# Variables d'environnement propres au projet client.
# `make aurora-update` / `make sync-env` ne touchent JAMAIS aux lignes
# en dessous de ce séparateur. Mets ici tes secrets, feature flags,
# intégrations tierces, etc.
# ============================================================
